{
  "name": "in2code/femanagerextended",
  "description": "Example addon extension to TYPO3 extension femanager",
  "keywords": [
    "typo3",
    "form",
    "femanager",
    "fe_users",
    "registration"
  ],
  "homepage": "https://github.com/in2code-de/femanagerextended",
  "authors": [
    {
      "name": "Alex Kellner",
      "email": "alexander.kellner@in2code.de"
    },
    {
      "name": "Daniel Hoffmann",
      "email": "daniel.hoffmann@in2code.de"
    }
  ],
  "type": "typo3-cms-extension",
  "license": "GPL-3.0",
  "require": {
    "php": "^8.2",
    "in2code/femanager": "^13.3",
    "typo3/cms-core": "^13.4"
  },
  "require-dev": {
    "helhum/typo3-console": "^8.2",
    "typo3/cms-adminpanel": "^13.4",
    "typo3/cms-backend": "^13.4",
    "typo3/cms-belog": "^13.4",
    "typo3/cms-beuser": "^13.4",
    "typo3/cms-extbase": "^13.4",
    "typo3/cms-extensionmanager": "^13.4",
    "typo3/cms-felogin": "^13.4",
    "typo3/cms-filelist": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-fluid-styled-content": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-info": "^13.4",
    "typo3/cms-install": "^13.4",
    "typo3/cms-lowlevel": "^13.4",
    "typo3/cms-rte-ckeditor": "^13.4",
    "typo3/cms-setup": "^13.4",
    "typo3/cms-tstemplate": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "In2code\\Femanagerextended\\": "Classes"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "bin-dir": ".Build/bin",
    "vendor-dir": ".Build/vendor"
  },
  "scripts": {
    "test:php:lint": "find *.php Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l"
  },
  "prefer-stable": true,
  "extra": {
    "typo3/cms": {
      "extension-key": "femanagerextended",
      "web-dir": ".Build/public"
    }
  }
}
